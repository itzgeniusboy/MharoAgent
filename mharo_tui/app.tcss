/* Mharo TUI — layout and skin.
   Only standard Textual theme variables are used so the sheet still parses on
   older Textual; theme-specific extras are applied from Python (app.apply_palette). */

Screen {
    background: $background;
}

/* ---- vertical flow: top bar / main / prompt / status ------------------ */

#top {
    height: 1;
    background: $surface;
    layout: horizontal;
}

.top-cell {
    height: 1;
    width: auto;
    max-width: 70;
}

.top-right {
    width: 1fr;
    max-width: 100%;
    align-horizontal: right;
    padding-right: 1;
}

#main {
    height: 1fr;
    layout: horizontal;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 2 1 2;
    scrollbar-size: 1 0;
}

#sidebar {
    width: 40;
    height: 1fr;
    background: $surface;
    border-left: solid $panel;
    padding: 0 1;
    overflow-y: auto;
}

.side-head {
    height: 1;
    margin-top: 1;
    padding-left: 1;
    text-style: bold;
}

.side-body {
    height: auto;
    padding-left: 1;
}

/* ---- transcript blocks ------------------------------------------------- */

Welcome {
    height: auto;
    margin-top: 1;
    padding: 1 0;
}

UserBlock {
    height: auto;
    background: $surface;
    padding: 0 1;
    margin: 1 0 0 0;
    border-left: thick $primary;
}

AssistantBlock {
    height: auto;
    margin: 1 0 0 0;
}

.block-head {
    height: 1;
}

NoticeBlock {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: solid $panel;
}

ErrorBlock {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: thick $error;
    background: $surface;
}

Markdown {
    height: auto;
    background: transparent;
}

/* ---- tool blocks ------------------------------------------------------- */

ToolView {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: solid $panel;
    background: $surface;
}

/* Every part of a tool block is height:auto and a direct child of the
   Collapsible; any 1fr child would stretch the fold across the transcript. */
ToolView {
    height: auto;
}

ToolView > Static {
    height: auto;
}

.tool-ok {
    border: solid $success;
}

.tool-error {
    border: solid $error;
}

.tool-denied {
    border: solid $warning;
}

.tool-out {
    width: 1fr;
    height: auto;
    max-height: 16;
    overflow-y: auto;
}

.tool-diff {
    height: auto;
    max-height: 18;
    overflow-y: auto;
    padding-left: 1;
}

/* ---- approval ---------------------------------------------------------- */

#approval {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border: thick $warning;
    background: $surface;
}

.approve-kicker {
    height: 1;
    color: $warning;
}

.approve-title {
    height: 1;
    padding-left: 1;
}

.approve-detail {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    padding: 0 0 0 2;
}

.approve-buttons {
    height: auto;
    align-horizontal: right;
    padding: 0 0 1 0;
}

.approve-buttons Button {
    height: 3;
    min-width: 18;
    margin: 0 0 0 1;
}

/* ---- palette + completion -------------------------------------------- */

#palette {
    height: auto;
    max-height: 15;
    margin: 0 2;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

.palette-title {
    height: 1;
}

#palette-list {
    height: auto;
    max-height: 13;
    background: transparent;
}

#prompt-box {
    height: auto;
    layout: vertical;
}

#completion {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    background: $surface;
}

/* ---- prompt ------------------------------------------------------------ */

#prompt {
    height: auto;
    padding: 0 1;
    border-top: solid $panel;
}

#prompt-input {
    height: 3;
    min-height: 3;
    max-height: 11;
    padding: 0 1;
    border: round $panel;
}

#prompt-input:focus {
    border: round $primary;
}

.prompt-placeholder {
    position: absolute;
    offset: 3 1;
    height: 1;
    width: 3fr;
}

#prompt-hint {
    height: 1;
    padding-left: 2;
}

/* ---- status ------------------------------------------------------------ */

#status {
    height: 1;
    background: $surface;
    padding: 0 1;
}



#state-text {
    width: auto;
    max-width: 46;
}

#status-hints {
    width: 1fr;
    align-horizontal: right;
}
